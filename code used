        job: jobTitle,
        status: "Submitted",
        date: new Date().toLocaleDateString()
    });

    saveData("kpritApplications", applications);
    notify(currentUser.email, "Application submitted for " + jobTitle + ".");

    alert("Application submitted successfully.");
    renderApplications();
    renderDashboard();
