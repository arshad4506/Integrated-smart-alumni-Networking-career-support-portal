
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>KPRIT Alumni Networking and Career Support Portal</title>

<style>
:root {
    --navy: #111827;
    --navy2: #1f2937;
    --gold: #d6a84f;
    --bg: #f5f7fa;
    --white: #ffffff;
    --text: #263244;
    --muted: #64748b;
    --border: #e2e8f0;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
}

header {
    background: var(--navy);
    color: white;
    padding: 16px 5%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    flex-wrap: wrap;
    position: sticky;
    top: 0;
    z-index: 100;
}

.logo {
    color: white;
    text-decoration: none;
    font-size: 23px;
    font-weight: bold;
}

.logo span, footer span {
    color: var(--gold);
}

nav {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
}

nav a {
    color: white;
    text-decoration: none;
    font-size: 14px;
}

nav a:hover {
    color: var(--gold);
}

button, .btn {
    border: none;
    padding: 10px 16px;
    border-radius: 5px;
    cursor: pointer;
    font-weight: bold;
    text-decoration: none;
    display: inline-block;
    font-size: 14px;
}

.btn-primary, button {
    background: var(--gold);
    color: var(--navy);
}

.btn-outline {
    background: transparent;
    color: white;
    border: 1px solid var(--gold);
}

button:hover, .btn:hover {
    opacity: .85;
}

.hero {
    min-height: 430px;
    background:
        linear-gradient(90deg, rgba(17,24,39,.93), rgba(17,24,39,.55)),
        url("https://media.getmyuni.com/azure/college-image/big/kommuri-pratap-reddy-institute-of-technology-kprit-rangareddi.jpg")
        center/cover;
    display: flex;
    align-items: center;
    padding: 60px 8%;
    color: white;
}

.hero-content {
    max-width: 650px;
}

.hero h1 {
    font-size: 43px;
    line-height: 1.2;
    margin: 18px 0;
}

.hero h1 span {
    color: var(--gold);
}

.hero p {
    margin-bottom: 22px;
}

.tag {
    color: var(--gold);
    font-weight: bold;
    letter-spacing: 1px;
    font-size: 13px;
}

.section {
    padding: 55px 7%;
    display: none;
}

.section h2 {
    color: var(--navy);
    margin: 10px 0 15px;
    font-size: 29px;
}

.section > p {
    color: var(--muted);
    margin-bottom: 20px;
}

#home {
    display: flex;
}

#features, #recommendations, #roles {
    display: block;
}

.card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 20px;
    margin-top: 25px;
}

.feature-card, .profile-card {
    background: white;
    padding: 22px;
    border-radius: 9px;
    border: 1px solid var(--border);
    box-shadow: 0 3px 12px rgba(0,0,0,.04);
}

.feature-card h3, .profile-card h3 {
    color: var(--navy);
    margin: 8px 0;
}

.feature-card p, .profile-card p {
    color: var(--muted);
    margin: 5px 0;
    font-size: 14px;
}

.feature-card button, .profile-card button {
    margin: 9px 5px 0 0;
}

.feature-icon {
    font-size: 30px;
}

.avatar {
    width: 55px;
    height: 55px;
    background: var(--navy);
    color: var(--gold);
    display: grid;
    place-items: center;
    border-radius: 50%;
    font-size: 24px;
    font-weight: bold;
}

input, select, textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: 5px;
    margin: 7px 0 14px;
    background: white;
}

label {
    font-weight: bold;
    font-size: 14px;
    display: block;
}

form {
    max-width: 550px;
    background: white;
    padding: 22px;
    border-radius: 9px;
    border: 1px solid var(--border);
}

.search-area {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 10px;
    max-width: 750px;
}

.search-area input {
    margin: 0;
}

.filter-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 12px;
    margin: 20px 0;
}

.filter-grid select {
    margin: 0;
}

.modal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.7);
    align-items: center;
    justify-content: center;
    padding: 15px;
    z-index: 200;
}

.modal-content {
    background: white;
    width: 100%;
    max-width: 480px;
    max-height: 90vh;
    overflow-y: auto;
    padding: 28px;
    border-radius: 10px;
    position: relative;
}

.modal-content h2 {
    color: var(--navy);
    margin-bottom: 8px;
}

.modal-content form {
    padding: 0;
    border: none;
}

.close {
    position: absolute;
    right: 15px;
    top: 12px;
    background: var(--navy);
    color: white;
    font-size: 20px;
    padding: 3px 11px;
}

.full-btn {
    width: 100%;
    margin-top: 10px;
}

.text-link {
    color: #1d4ed8;
    cursor: pointer;
    text-decoration: underline;
    display: inline-block;
    margin: 10px 0;
}

.status {
    display: inline-block;
    background: #e8edf4;
    padding: 4px 9px;
    border-radius: 4px;
    font-size: 12px;
    margin-top: 7px;
}

.notice {
    padding: 12px;
    background: #fff8e7;
    border-left: 4px solid var(--gold);
    margin: 15px 0;
}

footer {
    background: var(--navy);
    color: white;
    text-align: center;
    padding: 35px 15px;
}

footer p {
    margin: 7px 0;
}

footer a {
    color: white;
    margin: 0 7px;
}

.hidden {
    display: none !important;
}

.admin-table {
    width: 100%;
    border-collapse: collapse;
    background: white;
    margin-top: 15px;
}

.admin-table th, .admin-table td {
    padding: 12px;
    border: 1px solid var(--border);
    text-align: left;
    font-size: 13px;
}

.admin-table th {
    background: var(--navy);
    color: white;
}

@media(max-width: 850px) {
    header {
        position: relative;
        justify-content: center;
    }

    nav {
        justify-content: center;
    }

    .hero h1 {
        font-size: 33px;
    }
}

@media(max-width: 550px) {
    .section {
        padding: 35px 5%;
    }

    .hero {
        padding: 45px 6%;
    }

    .hero h1 {
        font-size: 29px;
    }

    .search-area {
        grid-template-columns: 1fr;
    }
}
</style>
</head>

<body>

<header>
    <a href="#" class="logo" onclick="showPage('home');return false;">
        KPRIT <span>ALUMNI</span>
    </a>

    <nav>
        <a href="#" onclick="showPage('home');return false;">Home</a>
        <a href="#" onclick="showPage('about');return false;">About</a>
        <a href="#" onclick="showPage('directory');return false;">Alumni</a>
        <a href="#" onclick="showPage('mentorship');return false;">Mentorship</a>
        <a href="#" onclick="showPage('jobs');return false;">Careers</a>
        <a href="#" onclick="showPage('events');return false;">Events</a>
        <a href="#" onclick="showPage('dashboard');return false;">Dashboard</a>
    </nav>

    <div>
        <button class="btn-outline" onclick="openLogin()">Login</button>
        <button onclick="openRegister()">Join Network</button>
    </div>
</header>

<main>

<!-- HOME -->
<section class="hero" id="home">
    <div class="hero-content">
        <span class="tag">KPRIT ALUMNI COMMUNITY</span>
        <h1>Connecting Alumni.<br>Empowering <span>Futures.</span></h1>
        <p>
            A smart networking and career support platform
            connecting KPRIT students, alumni and opportunities.
        </p>
        <button onclick="openRegister()">Join Our Network</button>
        <button class="btn-outline" onclick="showPage('directory')">
            Explore Alumni
        </button>
    </div>
</section>

<!-- HOME FEATURES -->
<section class="section" id="features">
    <span class="tag">WHAT WE OFFER</span>
    <h2>Explore Our Platform</h2>

    <div class="card-grid">
        <article class="feature-card">
            <div class="feature-icon">👥</div>
            <h3>Alumni Directory</h3>
            <p>Discover alumni and professional profiles.</p>
            <button onclick="showPage('directory')">Explore</button>
        </article>

        <article class="feature-card">
            <div class="feature-icon">🎓</div>
            <h3>Mentorship</h3>
            <p>Connect with experienced alumni.</p>
            <button onclick="showPage('mentorship')">Find Mentors</button>
        </article>

        <article class="feature-card">
            <div class="feature-icon">💼</div>
            <h3>Career Opportunities</h3>
            <p>Explore jobs and internships.</p>
            <button onclick="showPage('jobs')">Explore Jobs</button>
        </article>

        <article class="feature-card">
            <div class="feature-icon">📅</div>
            <h3>Events</h3>
            <p>Participate in alumni events.</p>
            <button onclick="showPage('events')">View Events</button>
        </article>

        <article class="feature-card">
            <div class="feature-icon">⭐</div>
            <h3>Favorites</h3>
            <p>Save your preferred alumni and jobs.</p>
            <button onclick="showPage('favorites')">My Favorites</button>
        </article>

        <article class="feature-card">
            <div class="feature-icon">🔔</div>
            <h3>Notifications</h3>
            <p>View your latest activities.</p>
            <button onclick="showPage('notifications')">View Updates</button>
        </article>
    </div>
</section>

<!-- ABOUT -->
<section class="section" id="about">
    <span class="tag">ABOUT OUR PLATFORM</span>
    <h2>Building Connections Beyond Graduation</h2>
    <p>
        The Integrated Smart Alumni Networking and Career Support Portal
        connects current students and graduates of KPRIT through
        professional networking, mentorship, career opportunities,
        institutional events and knowledge sharing.
    </p>
    <div class="notice">
        Our goal is to build a strong relationship between students,
        alumni and the institution.
    </div>
</section>

<!-- ALUMNI DIRECTORY -->
<section class="section" id="directory">
    <span class="tag">PROFESSIONAL NETWORKING</span>
    <h2>Alumni Directory</h2>
    <p>Search and connect with KPRIT alumni.</p>

    <div class="search-area">
        <input id="alumniSearch" placeholder="Search name, skills or company..."
               oninput="filterAlumni()">
        <button onclick="filterAlumni()">Search</button>
    </div>

    <div class="filter-grid">
        <select id="departmentFilter" onchange="filterAlumni()">
            <option value="">All Departments</option>
            <option>CSE</option>
            <option>ECE</option>
            <option>EEE</option>
            <option>IT</option>
            <option>Civil</option>
            <option>Mechanical</option>
        </select>

        <select id="batchFilter" onchange="filterAlumni()">
            <option value="">All Batches</option>
            <option>2020</option>
            <option>2021</option>
            <option>2022</option>
            <option>2023</option>
            <option>2024</option>
            <option>2025</option>
        </select>

        <select id="industryFilter" onchange="filterAlumni()">
            <option value="">All Industries</option>
            <option>IT</option>
            <option>Software</option>
            <option>Banking</option>
            <option>Education</option>
            <option>Core</option>
        </select>
    </div>

    <div class="card-grid" id="alumniResults"></div>
    <p id="alumniEmpty" class="hidden">No alumni found.</p>
</section>

<!-- MENTORSHIP -->
<section class="section" id="mentorship">
    <span class="tag">CAREER GUIDANCE</span>
    <h2>Alumni Mentorship Program</h2>
    <p>Request professional guidance from experienced alumni.</p>

    <div class="card-grid">
        <article class="feature-card">
            <h3>Find a Mentor</h3>
            <p>Get support for technical skills, interviews and career planning.</p>
            <button onclick="requestMentorship('Software Development Mentor')">
                Request Mentor
            </button>
        </article>

        <article class="feature-card">
            <h3>Become a Mentor</h3>
            <p>Share your professional knowledge with current students.</p>
            <button onclick="openLogin()">Login to Join</button>
        </article>
    </div>

    <h2>My Mentorship Requests</h2>
    <div class="card-grid" id="mentorshipList"></div>
</section>

<!-- JOBS -->
<section class="section" id="jobs">
    <span class="tag">CAREER OPPORTUNITIES</span>
    <h2>Jobs and Internships</h2>
    <p>Explore opportunities shared with the alumni community.</p>

    <div class="card-grid" id="jobsList"></div>

    <h2>My Job Applications</h2>
    <div class="card-grid" id="applicationsList"></div>
</section>

<!-- EVENTS -->
<section class="section" id="events">
    <span class="tag">CAMPUS CONNECTIONS</span>
    <h2>Events and Announcements</h2>

    <div class="card-grid">
        <article class="feature-card">
            <h3>Alumni Reunion</h3>
            <p>Reconnect with former classmates and faculty.</p>
            <button onclick="registerEvent('Alumni Reunion')">Register</button>
        </article>

        <article class="feature-card">
            <h3>Technical Webinar</h3>
            <p>Participate in technical knowledge-sharing sessions.</p>
            <button onclick="registerEvent('Technical Webinar')">Register</button>
        </article>

        <article class="feature-card">
            <h3>Career Guidance Session</h3>
            <p>Learn from experienced professionals.</p>
            <button onclick="registerEvent('Career Guidance Session')">Register</button>
        </article>
    </div>
</section>

<!-- FAVORITES -->
<section class="section" id="favorites">
    <span class="tag">SAVED ITEMS</span>
    <h2>My Favorites</h2>
    <div class="card-grid" id="favoritesList"></div>
</section>

<!-- DASHBOARD -->
<section class="section" id="dashboard">
    <span class="tag">USER ACCOUNT</span>
    <h2>My Dashboard</h2>

    <div id="dashboardWelcome" class="notice">
        Please login to view your dashboard.
    </div>

    <div class="card-grid">
        <article class="feature-card">
            <h3>My Profile</h3>
            <div id="profileDetails">Login to view your profile.</div>
            <button onclick="editProfile()">Edit Profile</button>
        </article>

        <article class="feature-card">
            <h3>My Mentorship Requests</h3>
            <p id="dashMentorship">0 requests</p>
            <button onclick="showPage('mentorship')">View Requests</button>
        </article>

        <article class="feature-card">
            <h3>My Job Applications</h3>
            <p id="dashApplications">0 applications</p>
            <button onclick="showPage('jobs')">Track Applications</button>
        </article>

        <article class="feature-card">
            <h3>My Events</h3>
            <p id="dashEvents">0 registrations</p>
            <button onclick="showPage('events')">View Events</button>
        </article>

        <article class="feature-card">
            <h3>My Resume</h3>
            <input type="file" id="resumeUpload" accept=".pdf,.doc,.docx">
            <p id="resumeMessage">Choose your resume file.</p>
        </article>

        <article class="feature-card">
            <h3>Notifications</h3>
            <p id="dashNotifications">0 notifications</p>
            <button onclick="showPage('notifications')">View Notifications</button>
        </article>
    </div>
</section>

<!-- NOTIFICATIONS -->
<section class="section" id="notifications">
    <span class="tag">UPDATES</span>
    <h2>My Notifications</h2>
    <div class="card-grid" id="notificationList"></div>
</section>

<!-- FEEDBACK -->
<section class="section" id="feedback">
    <span class="tag">YOUR OPINION MATTERS</span>
    <h2>Feedback and Support</h2>

    <form id="feedbackForm">
        <label>Your Name</label>
        <input id="feedbackName" required>

        <label>Email Address</label>
        <input type="email" id="feedbackEmail" required>

        <label>Your Feedback</label>
        <textarea id="feedbackMessage" rows="4" required></textarea>

        <button type="submit">Submit Feedback</button>
    </form>
</section>

<!-- ADMIN -->
<section class="section" id="admin">
    <span class="tag">ADMINISTRATION</span>
    <h2>Admin Management Panel</h2>
    <div class="notice">
        Administrator access is required to view this section.
    </div>

    <div class="card-grid">
        <article class="feature-card">
            <h3>Total Users</h3>
            <h2 id="adminUsers">0</h2>
        </article>

        <article class="feature-card">
            <h3>Job Applications</h3>
            <h2 id="adminApplications">0</h2>
        </article>

        <article class="feature-card">
            <h3>Mentorship Requests</h3>
            <h2 id="adminMentorship">0</h2>
        </article>
    </div>

    <h2>Registered Users</h2>
    <div id="adminUserList"></div>

    <h2>Job Applications</h2>
    <div id="adminApplicationList"></div>

    <h2>Feedback Received</h2>
    <div id="adminFeedbackList"></div>
</section>

<!-- ROLES -->
<section class="section" id="roles">
    <span class="tag">JOIN OUR COMMUNITY</span>
    <h2>Choose Your Role</h2>
    <div class="card-grid">
        <article class="feature-card">
            <h3>Student</h3>
            <p>Connect with alumni, find mentors and explore jobs.</p>
            <button onclick="openRegister('Student')">Join as Student</button>
        </article>

        <article class="feature-card">
            <h3>Alumni</h3>
            <p>Guide students and share career opportunities.</p>
            <button onclick="openRegister('Alumni')">Join as Alumni</button>
        </article>

        <article class="feature-card">
            <h3>Administrator</h3>
            <p>Manage portal activities.</p>
            <button onclick="openLogin('Admin')">Admin Login</button>
        </article>
    </div>
</section>

</main>

<!-- LOGIN MODAL -->
<div class="modal" id="loginModal">
    <div class="modal-content">
        <button class="close" onclick="closeModals()">×</button>
        <h2>Welcome Back</h2>
        <p>Login to your KPRIT Alumni account.</p>

        <form id="loginForm">
            <label>Email Address</label>
            <input type="email" id="loginEmail" required>

            <label>Password</label>
            <input type="password" id="loginPassword" required>

            <label>Login As</label>
            <select id="loginRole">
                <option>Student</option>
                <option>Alumni</option>
                <option>Admin</option>
            </select>

            <button class="full-btn" type="submit">Login</button>
        </form>

        <span class="text-link" onclick="openForgotPassword()">
            Forgot Password?
        </span>
        <br>
        <span class="text-link" onclick="openRegister()">
            Create a new account
        </span>
    </div>
</div>

<!-- REGISTER MODAL -->
<div class="modal" id="registerModal">
    <div class="modal-content">
        <button class="close" onclick="closeModals()">×</button>
        <h2>Create Account</h2>

        <form id="registerForm">
            <label>Full Name</label>
            <input id="registerName" required>

            <label>Email Address</label>
            <input type="email" id="registerEmail" required>

            <label>Mobile Number</label>
            <input type="tel" id="registerMobile" pattern="[0-9]{10}"
                   maxlength="10" required>

            <label>Department</label>
            <select id="registerDepartment" required>
                <option value="">Select Department</option>
                <option>CSE</option>
                <option>ECE</option>
                <option>EEE</option>
                <option>IT</option>
                <option>Civil</option>
                <option>Mechanical</option>
            </select>

            <label>Graduation Year</label>
            <input type="number" id="registerBatch" min="2000" max="2035" required>

            <label>Industry / Career Field</label>
            <input id="registerIndustry" placeholder="Example: Software">

            <label>Password</label>
            <input type="password" id="registerPassword" minlength="8" required>

            <label>Confirm Password</label>
            <input type="password" id="confirmPassword" minlength="8" required>

            <label>Register As</label>
            <select id="registerRole">
                <option>Student</option>
                <option>Alumni</option>
            </select>

            <button class="full-btn" type="submit">Create Account</button>
        </form>
    </div>
</div>

<!-- FORGOT PASSWORD MODAL -->
<div class="modal" id="forgotModal">
    <div class="modal-content">
        <button class="close" onclick="closeModals()">×</button>
        <h2>Reset Password</h2>
        <p>Enter your registered email and mobile number.</p>

        <form id="forgotForm">
            <label>Registered Email</label>
            <input type="email" id="forgotEmail" required>

            <label>Registered Mobile Number</label>
            <input type="tel" id="forgotMobile" pattern="[0-9]{10}"
                   maxlength="10" required>

            <label>New Password</label>
            <input type="password" id="newPassword" minlength="8" required>

            <label>Confirm New Password</label>
            <input type="password" id="confirmNewPassword" minlength="8" required>

            <button class="full-btn" type="submit">Reset Password</button>
        </form>
    </div>
</div>

<!-- EDIT PROFILE MODAL -->
<div class="modal" id="profileModal">
    <div class="modal-content">
        <button class="close" onclick="closeModals()">×</button>
        <h2>Edit Profile</h2>
        <form id="profileForm">
            <label>Full Name</label>
            <input id="editName" required>

            <label>Mobile Number</label>
            <input id="editMobile" pattern="[0-9]{10}" maxlength="10" required>

            <label>Department</label>
            <input id="editDepartment" required>

            <label>Graduation Year</label>
            <input type="number" id="editBatch" required>

            <label>Industry</label>
            <input id="editIndustry">

            <button class="full-btn" type="submit">Save Changes</button>
        </form>
    </div>
</div>

<footer>
    <h2>KPRIT <span>ALUMNI</span></h2>
    <p>Integrated Smart Alumni Networking and Career Support Portal</p>
    <p>Connecting Students, Alumni and Career Opportunities.</p>
    <p>
        <a href="#" onclick="showPage('about');return false;">About</a>
        <a href="#" onclick="showPage('directory');return false;">Alumni</a>
        <a href="#" onclick="showPage('jobs');return false;">Careers</a>
        <a href="#" onclick="showPage('feedback');return false;">Feedback</a>
    </p>
    <p>© 2026 KPRIT. All Rights Reserved.</p>
</footer>

<script>
// ======================================
// DATA AND STORAGE
// ======================================

const readData = (key, fallback = []) => {
    try {
        return JSON.parse(localStorage.getItem(key)) ?? fallback;
    } catch {
        return fallback;
    }
};

const saveData = (key, value) => {
    localStorage.setItem(key, JSON.stringify(value));
};

let currentUser = null;

function getUsers() {
    return readData("kpritUsers");
}

function getApplications() {
    return readData("kpritApplications");
}

function getMentorship() {
    return readData("kpritMentorship");
}

function getNotifications() {
    return readData("kpritNotifications");
}

function notify(userEmail, message) {
    const list = getNotifications();
    list.unshift({
        email: userEmail,
        message: message,
        date: new Date().toLocaleString()
    });
    saveData("kpritNotifications", list);
}

