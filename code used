// ======================================
// FAVORITES
// ======================================

function getFavorites() {
    return readData("kpritFavorites");
}

function saveFavorite(item) {
    if (!currentUser) {
        alert("Please login to save favorites.");
        openLogin();
        return;
    }

    const favorites = getFavorites();

    if (favorites.some(value =>
        value.email === currentUser.email && value.item === item
    )) {
        alert("Already saved.");
        return;
    }

    favorites.push({
        email: currentUser.email,
        item: item
    });

    saveData("kpritFavorites", favorites);
    alert("Added to favorites.");
    renderFavorites();
}

function renderFavorites() {
    const container = document.getElementById("favoritesList");
    container.innerHTML = "";

    if (!currentUser) {
        container.textContent = "Please login to view favorites.";
        return;
    }

    const favorites = getFavorites().filter(item =>
        item.email === currentUser.email
    );

    if (!favorites.length) {
        container.textContent = "No saved items.";
        return;
    }

    favorites.forEach(item => {
        const card = document.createElement("article");
        card.className = "feature-card";

        const title = document.createElement("h3");
        title.textContent = item.item;

        const remove = document.createElement("button");
        remove.textContent = "Remove";
        remove.onclick = () => {
            saveData("kpritFavorites", getFavorites().filter(value =>
                !(value.email === currentUser.email && value.item === item.item)
            ));
            renderFavorites();
        };

        card.append(title, remove);
        container.appendChild(card);
    });
}

