    requests.push({
        email: currentUser.email,
        mentor: mentor,
        status: "Pending",
        date: new Date().toLocaleDateString()
    });

    saveData("kpritMentorship", requests);
    notify(currentUser.email, "Mentorship request submitted to " + mentor + ".");

    alert("Mentorship request submitted successfully.");
    renderMentorship();
}

