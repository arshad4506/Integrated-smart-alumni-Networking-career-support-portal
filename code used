// ======================================
// PAGE NAVIGATION
// ======================================

const pageIds = [
    "home", "features", "about", "directory", "mentorship",
    "jobs", "events", "favorites", "dashboard",
    "notifications", "feedback", "admin", "roles"
];

function showPage(pageId) {
    if (pageId === "admin" &&
        (!currentUser || currentUser.role !== "Admin")) {
        alert("Please login as administrator.");
        openLogin("Admin");
        return;
    }

    document.querySelectorAll("main > section").forEach(section => {
        section.style.display = "none";
    });

    if (pageId === "home") {
        ["home", "features", "recommendations", "roles"].forEach(id => {
            const section = document.getElementById(id);
            if (section) section.style.display = "block";
        });
        document.getElementById("home").style.display = "flex";
    } else {
        const section = document.getElementById(pageId);
        if (section) section.style.display = "block";
    }

    window.scrollTo({ top: 0, behavior: "smooth" });

    if (pageId === "directory") renderAlumni();
    if (pageId === "dashboard") renderDashboard();
    if (pageId === "mentorship") renderMentorship();
    if (pageId === "jobs") renderJobs();
    if (pageId === "favorites") renderFavorites();
    if (pageId === "notifications") renderNotifications();
    if (pageId === "admin") renderAdmin();
}

// ======================================
// MODAL FUNCTIONS
// ======================================

function openLogin(role) {
    closeModals();
    document.getElementById("loginModal").style.display = "flex";

    if (role) {
        document.getElementById("loginRole").value = role;
    }
}

function openRegister(role) {
    closeModals();
    document.getElementById("registerModal").style.display = "flex";

    if (role) {
        document.getElementById("registerRole").value = role;
    }
}

function openForgotPassword() {
    closeModals();
    document.getElementById("forgotModal").style.display = "flex";
}

function closeModals() {
    document.querySelectorAll(".modal").forEach(modal => {
        modal.style.display = "none";
    });
}

window.addEventListener("click", event => {
    if (event.target.classList.contains("modal")) {
        closeModals();
    }
});

// ======================================
// REGISTRATION
// ======================================

document.getElementById("registerForm").addEventListener("submit", function(e) {
    e.preventDefault();

    const user = {
        name: document.getElementById("registerName").value.trim(),
        email: document.getElementById("registerEmail").value.trim().toLowerCase(),
        mobile: document.getElementById("registerMobile").value.trim(),
        department: document.getElementById("registerDepartment").value,
        batch: document.getElementById("registerBatch").value,
        industry: document.getElementById("registerIndustry").value.trim(),
        password: document.getElementById("registerPassword").value,
        role: document.getElementById("registerRole").value
    };

    const confirm = document.getElementById("confirmPassword").value;

    if (user.password !== confirm) {
        alert("Passwords do not match.");
        return;
    }

    if (!/^[0-9]{10}$/.test(user.mobile)) {
        alert("Enter a valid 10-digit mobile number.");
        return;
    }

    const users = getUsers();

    if (users.some(existing => existing.email === user.email)) {
        alert("This email is already registered.");
        return;
    }

    if (users.some(existing => existing.mobile === user.mobile)) {
        alert("This mobile number is already registered.");
        return;
    }

    users.push(user);
    saveData("kpritUsers", users);

    notify(user.email, "Welcome to KPRIT Alumni Portal.");

    alert("Account created successfully. Please login.");
    this.reset();
    closeModals();
    openLogin();
});

// ======================================
// LOGIN
// ======================================

document.getElementById("loginForm").addEventListener("submit", function(e) {
    e.preventDefault();

    const email = document.getElementById("loginEmail").value.trim().toLowerCase();
    const password = document.getElementById("loginPassword").value;
    const role = document.getElementById("loginRole").value;

    const user = getUsers().find(item =>
        item.email === email &&
        item.password === password &&
        item.role === role
    );

    if (!user) {
        alert("Invalid email, password or account role.");
        return;
    }

    currentUser = user;
    localStorage.setItem("kpritCurrentUser", user.email);

    alert("Welcome, " + user.name + "!");
    this.reset();
    closeModals();
    renderDashboard();
    showPage("dashboard");
});

// ======================================
// LOGOUT
// ======================================

function logout() {
    currentUser = null;
    localStorage.removeItem("kpritCurrentUser");
    alert("You have logged out.");
    showPage("home");
}

// ======================================
// FORGOT PASSWORD
// ======================================

document.getElementById("forgotForm").addEventListener("submit", function(e) {
    e.preventDefault();

    const email = document.getElementById("forgotEmail").value.trim().toLowerCase();
    const mobile = document.getElementById("forgotMobile").value.trim();
    const password = document.getElementById("newPassword").value;
    const confirm = document.getElementById("confirmNewPassword").value;

    if (password !== confirm) {
        alert("New passwords do not match.");
        return;
    }

    const users = getUsers();
    const index = users.findIndex(user =>
        user.email === email && user.mobile === mobile
    );

    if (index === -1) {
        alert("No matching account was found.");
        return;
    }

    users[index].password = password;
    saveData("kpritUsers", users);

    notify(email, "Your password was changed.");

    alert("Password updated successfully. Please login.");
    this.reset();
    closeModals();
    openLogin();
});

// ======================================
// ALUMNI DIRECTORY
// ======================================

function renderAlumni() {
    const users = getUsers().filter(user => user.role === "Alumni");
    const container = document.getElementById("alumniResults");

    container.innerHTML = "";

    users.forEach(user => {
        const card = document.createElement("article");
        card.className = "profile-card alumni-card";

        const avatar = document.createElement("div");
        avatar.className = "avatar";
        avatar.textContent = user.name.charAt(0).toUpperCase();

        const heading = document.createElement("h3");
        heading.textContent = user.name;

        const details = document.createElement("p");
        details.textContent =
            "Department: " + user.department +
            " | Batch: " + user.batch +
            " | Industry: " + user.industry;

        const connect = document.createElement("button");
        connect.textContent = "Request Connection";
        connect.onclick = () => requestMentorship(user.name);

        const save = document.createElement("button");
        save.textContent = "☆ Save";
        save.onclick = () => saveFavorite(user.name);

        card.append(avatar, heading, details, connect, save);
        container.appendChild(card);
    });

    filterAlumni();
}

function filterAlumni() {
    const search = document.getElementById("alumniSearch").value.toLowerCase();
    const department = document.getElementById("departmentFilter").value;
    const batch = document.getElementById("batchFilter").value;
    const industry = document.getElementById("industryFilter").value;

    const cards = document.querySelectorAll(".alumni-card");
    let count = 0;

    cards.forEach(card => {
        const text = card.innerText.toLowerCase();
        const show =
            text.includes(search) &&
            (!department || text.includes(department.toLowerCase())) &&
            (!batch || text.includes(batch)) &&
            (!industry || text.includes(industry.toLowerCase()));

        card.style.display = show ? "" : "none";
        if (show) count++;
    });

    document.getElementById("alumniEmpty").classList.toggle("hidden", count !== 0);
}

