// ======================================
// ADMIN PANEL
// ======================================

function renderAdmin() {
    if (!currentUser || currentUser.role !== "Admin") return;

    const users = getUsers();
    const applications = getApplications();
    const mentorship = getMentorship();
    const feedback = readData("kpritFeedback");

    document.getElementById("adminUsers").textContent = users.length;
    document.getElementById("adminApplications").textContent = applications.length;
    document.getElementById("adminMentorship").textContent = mentorship.length;

    const userContainer = document.getElementById("adminUserList");
    userContainer.innerHTML = "";

    const table = document.createElement("table");
    table.className = "admin-table";
    table.innerHTML = "<tr><th>Name</th><th>Email</th><th>Role</th><th>Action</th></tr>";

    users.forEach((user, index) => {
        const row = document.createElement("tr");

        [user.name, user.email, user.role].forEach(value => {
            const cell = document.createElement("td");
            cell.textContent = value;
            row.appendChild(cell);
        });

        const actionCell = document.createElement("td");
        const button = document.createElement("button");
        button.textContent = user.role === "Admin" ? "Admin" : "Remove";
        button.disabled = user.role === "Admin";
        button.onclick = () => removeUser(index);
        actionCell.appendChild(button);
        row.appendChild(actionCell);
        table.appendChild(row);
    });

    userContainer.appendChild(table);

    const appContainer = document.getElementById("adminApplicationList");
    appContainer.innerHTML = "";

    applications.forEach((application, index) => {
        const card = document.createElement("article");
        card.className = "feature-card";

        const title = document.createElement("h3");
        title.textContent = application.job;

        const email = document.createElement("p");
        email.textContent = "Applicant: " + application.email;

        const select = document.createElement("select");
        ["Submitted", "Under Review", "Shortlisted", "Rejected"].forEach(status => {
            const option = document.createElement("option");
            option.value = status;
            option.textContent = status;
            if (status === application.status) option.selected = true;
            select.appendChild(option);
        });

        select.onchange = () => {
            const updated = getApplications();
            updated[index].status = select.value;
            saveData("kpritApplications", updated);
            notify(application.email, "Your application status changed to " + select.value + ".");
            alert("Application status updated.");
        };

        card.append(title, email, select);
        appContainer.appendChild(card);
    });

    const feedbackContainer = document.getElementById("adminFeedbackList");
    feedbackContainer.innerHTML = "";

    feedback.forEach(item => {
        const card = document.createElement("article");
        card.className = "feature-card";

        const name = document.createElement("h3");
        name.textContent = item.name;

        const email = document.createElement("p");
        email.textContent = item.email;

        const message = document.createElement("p");
        message.textContent = item.message;

        card.append(name, email, message);
        feedbackContainer.appendChild(card);
    });
}

function removeUser(index) {
    const users = getUsers();

    if (!confirm("Are you sure you want to remove this user?")) return;

    const removed = users[index];

    if (!removed || removed.role === "Admin") return;

    users.splice(index, 1);
    saveData("kpritUsers", users);

    alert("User removed from this demonstration.");
    renderAdmin();
}

// ======================================
// RESTORE LOGIN SESSION
// ======================================

function restoreSession() {
    const email = localStorage.getItem("kpritCurrentUser");

    if (email) {
        currentUser = getUsers().find(user => user.email === email) || null;
    }
}

// ======================================
// INITIALIZATION
// ======================================

document.addEventListener("DOMContentLoaded", function() {
    initializeAdmin();
    restoreSession();

    showPage("home");
    renderAlumni();
    renderJobs();
    renderDashboard();
});

